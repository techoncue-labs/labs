# Optional: copy to .env next to compose.yaml instead of using export (docker compose reads .env automatically).
#   cp .env.example .env
# Release tag to run (pin a version instead of latest).
EDGE_EVER_VERSION=v2.28.0
# Long random admin password, for example from: openssl rand -hex 32
EDGE_EVER_AUTH_PASSWORD=CHANGE_ME_long_random_string
# Optional: username (default admin) and host port (default 8787)
# EDGE_EVER_AUTH_USERNAME=admin
# EDGE_EVER_PORT=8787
